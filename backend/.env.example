# Backend environment — copy to .env and fill in.
# Never commit the real .env.

# ── Core ─────────────────────────────────────────────────────────────────
MONGODB_URI=
# REQUIRED. The server refuses to boot without it, and tokens are only ever
# signed with this value — there is no fallback key.
JWT_SECRET=
FRONTEND_URL=
NODE_ENV=development
PORT=5000

# ── Automation Hub ───────────────────────────────────────────────────────
# REQUIRED. Without this the Automation Hub cannot create, edit, delete or
# dispatch a single schedule — every GitHub call fails with "Bad credentials".
#
# Mint at https://github.com/settings/tokens
#   Classic token  → scopes: repo, workflow
#   Fine-grained   → the bot repository, with Contents: Read and write
#                    and Actions: Read and write
#
# Set it in BOTH places the backend runs: this file for local development,
# and the host's environment settings for the deployed backend.
GITHUB_PAT=

# Which repository holds the bot and its workflow files. Defaults shown; only
# set these if the bot moves.
# GITHUB_OWNER=d0ul0s
# GITHUB_REPO=Residential-Proxy-Method
# GITHUB_BRANCH=main

# Shared secret for POST /api/submissions/report, the reader bot's webhook.
# That endpoint banks confirmation replies and can trigger a real Messenger
# post. The guard is fail-closed: while this is unset the endpoint answers 503
# and nobody — not even the bot — gets through. Set it here AND as a
# repository secret on the bot (sent as the x-bot-secret header) together,
# or the reader bot's reports will be rejected until both are configured.
BOT_WEBHOOK_SECRET=

# ── Email ────────────────────────────────────────────────────────────────
EMAIL_USER=
EMAIL_APP_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ── Integrations ─────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
APPS_SCRIPT_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
